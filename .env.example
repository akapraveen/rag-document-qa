# Answer model. auto = Claude if ANTHROPIC_API_KEY is set, else Ollama if OLLAMA_MODEL is pulled,
# else extractive mode (quotes the best passages, no LLM). Options: auto | anthropic | ollama | none
LLM_PROVIDER=auto
# From console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Pull first: ollama pull llama3.2:3b
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434

# Retrieval: local ONNX embeddings via FastEmbed, then hybrid vector + BM25 search
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_CANDIDATES=20

# Storage. RAG_SEED_SAMPLES=1 loads sample_docs/ into an empty library on first start
RAG_DATA_DIR=storage
RAG_SEED_SAMPLES=1
RAG_MAX_UPLOAD_MB=25
API_URL=http://localhost:8000
